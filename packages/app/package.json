{
  "name": "@tiny-schedule/app",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Tiny Schedule — Local-first Electron task manager with AI insights, Super Productivity import, Markdown export",
  "author": {
    "name": "dkisser",
    "email": "noreply@dkisser.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dkisser/Tiny-Schedule.git"
  },
  "homepage": "https://github.com/dkisser/Tiny-Schedule",
  "main": "./out/main/main.js",
  "scripts": {
    "build:event-helper": "bash ./scripts/build-event-helper.sh",
    "dev": "npm run build:event-helper && electron-vite dev",
    "build": "npm run build:event-helper && electron-vite build",
    "test": "bun test",
    "release": "REBUILD_EVENT_HELPER=1 npm run build:event-helper && electron-builder --mac --publish never --config electron-builder.yml",
    "release:dir": "REBUILD_EVENT_HELPER=1 npm run build:event-helper && electron-builder --mac --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@tiny-schedule/shared": "workspace:*",
    "cherry-markdown": "^0.11.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "typebox": "^1.3.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.10"
  }
}
