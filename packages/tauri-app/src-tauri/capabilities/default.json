        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key.tmp"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/**"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/.key.tmp"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app"
        },
