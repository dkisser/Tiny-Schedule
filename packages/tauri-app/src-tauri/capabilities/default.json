{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Wave 3 capability set. fs:default (which would grant the entire home directory) is replaced by explicit scopes covering only the two data directories: the Electron one the app has always used, and the dev sandbox. Each scope names the directory, its contents, and `.key`/`.key.tmp` explicitly because the glob matcher does not cross dotfiles. http is narrowed to three hosts: the local SSE mock, the dev server, and the GitHub releases API the manual update check reads. The AI providers are deliberately absent — they stream, and streaming goes through the Rust bridge in sse.rs, not through this plugin. dialog gains ask/confirm on top of default because the quit-with-a-running-timer confirmation and the import/export pickers both need them. os is narrowed to the single `type` call: isMacOS() in src/lib/platform.ts only needs to know the OS family, and the plugin exposes far more (hostname, IPs, memory, CPU) that nothing here should reach.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "notification:default",
    "opener:default",
    "os:allow-os-type",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8788/*"
        },
        {
          "url": "http://localhost:1420/*"
        },
        {
          "url": "https://api.github.com/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/**"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key.tmp"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/**"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/.key.tmp"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/**"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key.tmp"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/**"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/.key.tmp"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/**"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app/.key.tmp"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev"
        },
        {
          "path": "$HOME/Library/Application Support/@tiny-schedule/app-dev/**"
        },
